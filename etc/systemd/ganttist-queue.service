[Unit]
Description=Ganttist Laravel queue worker
After=network.target mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/Ganttist
ExecStart=/usr/bin/php artisan queue:work database --queue=sync,planning --sleep=1 --tries=3 --timeout=120 --max-time=3600
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=130

[Install]
WantedBy=multi-user.target
