[Unit]
Description=Ganttist document processing queue worker
After=network.target mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/Ganttist
ExecStart=/usr/bin/php artisan queue:work documents --queue=documents --sleep=2 --tries=3 --timeout=300 --max-time=3600
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=310

[Install]
WantedBy=multi-user.target
